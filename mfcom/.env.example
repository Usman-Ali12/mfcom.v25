# Copy this to .env.local (git-ignored) and fill in real values.
# Never commit actual keys — this file is the documented, secret-free template.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional — powers the "Remove background" button on the admin product
# form (manually-photographed items, e.g. a phone photo of a mouse on a
# desk). Free tier, no card required: https://www.remove.bg/api
# Without this set, that button shows a message explaining how to add it —
# everything else in the app works fine without it.
REMOVEBG_API_KEY=

# Optional — powers "AI-suggest from name" on the product form and "AI
# Enrich" in the products list bulk actions, for filling in a description
# and specs from just a product name (the main pain point after a bulk CSV
# import: 100+ products with only a name and a price). Free tier, no card
# required: https://aistudio.google.com/apikey
# Without this set, those buttons show a message explaining how to add it.
GEMINI_API_KEY=
