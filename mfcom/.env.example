# Copy this to .env.local (git-ignored) and fill in real values.
# Never commit actual keys — this file is the documented, secret-free template.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional — powers the "Remove background" button on the admin product
# form (manually-photographed items, e.g. a phone photo of a mouse on a
# desk). Free tier, no card required: https://www.remove.bg/api
# Without this set, that button shows a message explaining how to add it —
# everything else in the app works fine without it.
REMOVEBG_API_KEY=
