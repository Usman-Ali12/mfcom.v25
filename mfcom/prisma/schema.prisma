// -----------------------------------------------------------------------------
// MF COM — Phase 1 schema.
// Covers: catalog (Product/Category/Brand), orders, promotions, and the
// page-builder tables (Page/PageVersion) that the visual builder writes to.
// Automation/Webhook models arrive in the phase that builds the automation
// admin — kept out for now so this migration stays reviewable.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  EDITOR
  ORDER_MANAGER
}

enum StockState {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  image    String?
  products Product[]
}

model Product {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  sku              String     @unique
  brandId          String
  brand            Brand      @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category   @relation(fields: [categoryId], references: [id])
  description      String
  shortDescription String?
  price            Int // stored in smallest currency unit (PKR, no decimals needed)
  salePrice        Int?
  cost             Int?
  stock            Int        @default(0)
  lowStockThreshold Int       @default(5)
  stockState       StockState @default(IN_STOCK)
  images           ProductImage[]
  specifications   ProductSpecification[]
  variants         ProductVariant[]
  seoTitle         String?
  metaDescription  String?
  ogImage          String?
  published        Boolean    @default(false)
  orderItems       OrderItem[]
  reviews          Review[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String // e.g. "Processor", "RAM", "Refresh rate"
  value     String
  position  Int     @default(0)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // e.g. "Color: Black"
  sku       String  @unique
  priceDiff Int     @default(0)
  stock     Int     @default(0)
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  orders    Order[]
  reviews   Review[]
  createdAt DateTime @default(now())
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  total      Int
  status     OrderStatus @default(PENDING)
  couponCode String?
  createdAt  DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int // price at time of purchase
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  percentOff  Int?
  amountOff   Int?
  active      Boolean  @default(true)
  expiresAt   DateTime?
}

model Promotion {
  id          String   @id @default(cuid())
  name        String
  title       String
  description String?
  banner      String?
  startDate   DateTime
  endDate     DateTime
  discount    Int? // percent
  ctaLabel    String?
  ctaHref     String?
  active      Boolean  @default(true)
  productIds  String[]
  categoryIds String[]
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  altText   String?
  createdAt DateTime @default(now())
}

// --- Page builder ------------------------------------------------------------

model Page {
  id         String        @id @default(cuid())
  slug       String        @unique // "home", "about", etc.
  title      String
  status     PageStatus    @default(DRAFT)
  versions   PageVersion[]
  publishedVersionId String? @unique
}

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  // Full section tree for the page builder — see /lib/builder/types.ts for
  // the discriminated-union shape this JSON is validated against with zod.
  sections  Json
  createdAt DateTime @default(now())
  createdBy String?
}

model NavigationItem {
  id       String  @id @default(cuid())
  menu     String // "header" | "footer" | "side"
  label    String
  href     String?
  parentId String?
  position Int     @default(0)
}

model ThemeSettings {
  id            String @id @default("default")
  brandRed      String @default("#E2231A")
  brandBlack    String @default("#0B0B0C")
  containerWidth Int   @default(1440)
}

model SiteSettings {
  id                    String  @id @default("default")
  logoUrl               String  @default("/logo.png")
  whatsappNumber        String?
  whatsappDefaultMessage String?
  whatsappEnabled       Boolean @default(true)
}
